  <main>
    <!-- Page Header Hero Block -->
    <section class="page-hero-section" style="background-image: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.85)), url('about-us.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; padding: 6rem 2rem; border-radius: 12px; margin-bottom: 3.5rem !important; text-align: center; color: #ffffff;">
      <h1 style="font-family: 'Spectral', serif; font-size: 3.5rem; font-weight: 400; line-height: 1.15; margin: 0; color: #ffffff;">
        Schedule a Free Consultation
      </h1>
    </section>

    <!-- Consultation Form Section -->
    <section style="max-width: 1150px; margin: 0 auto 6rem auto; padding: 0 1rem;">
      <div class="contact-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start;">
        
        <!-- Left Column: Info -->
        <div>
          <span class="section-eyebrow" style="color: var(--accent);">Complimentary Discovery Call</span>
          <h2 style="font-family: 'Spectral', serif; font-size: 2.25rem; color: var(--text); margin: 0.5rem 0 1.25rem 0;">Start a conversation about your financial goals.</h2>
          <p style="color: var(--muted); line-height: 1.7; margin-bottom: 1.5rem;">
            Share a few details about where you are today and what you would like to accomplish with your 401(k), IRA, pension, brokerage accounts, or retirement plan. Submitting the form will prepare an email to <strong>info@seeksaveinvestments.com</strong>.
          </p>

          <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: flex; flex-direction: column; gap: 0.75rem;">
            <li style="position: relative; padding-left: 1.75rem; color: var(--muted); font-size: 0.95rem;">
              <span style="position: absolute; left: 0; color: #dc2626; font-weight: bold;">✔</span> No obligation or high-pressure sales pitch
            </li>
            <li style="position: relative; padding-left: 1.75rem; color: var(--muted); font-size: 0.95rem;">
              <span style="position: absolute; left: 0; color: #dc2626; font-weight: bold;">✔</span> Personalized review of your objectives and timeline
            </li>
            <li style="position: relative; padding-left: 1.75rem; color: var(--muted); font-size: 0.95rem;">
              <span style="position: absolute; left: 0; color: #dc2626; font-weight: bold;">✔</span> Serving clients nationwide from Fort Worth, Texas
            </li>
          </ul>

          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; color: var(--muted); font-size: 0.95rem; line-height: 1.7;">
            <strong style="color: var(--text); display: block; margin-bottom: 0.35rem;">Prefer to reach out directly?</strong>
            Email: <a href="mailto:info@seeksaveinvestments.com" style="color: var(--accent);">info@seeksaveinvestments.com</a><br>
            Phone: (713) 823-4658
          </div>
        </div>

        <!-- Right Column: Form -->
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2.5rem;">
          <form id="consultation-form" onsubmit="sendConsultationEmail(event);" style="display: flex; flex-direction: column; gap: 1.25rem;">
            
            <div>
              <label for="full-name" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">Full Name *</label>
              <input id="full-name" name="full-name" type="text" autocomplete="name" required placeholder="Your full name" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; box-sizing: border-box;">
            </div>

            <div>
              <label for="email" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">Email Address *</label>
              <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; box-sizing: border-box;">
            </div>

            <div>
              <label for="phone" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">Phone Number</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(713) 555-0199" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; box-sizing: border-box;">
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
              <div>
                <label for="preferred-date" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">Preferred Date</label>
                <input id="preferred-date" name="preferred-date" type="date" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; box-sizing: border-box;">
              </div>

              <div>
                <label for="preferred-time" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">Preferred Time (CT)</label>
                <select id="preferred-time" name="preferred-time" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; box-sizing: border-box;">
                  <option value="Morning (9:00 AM – 12:00 PM)">Morning (9:00 AM – 12:00 PM)</option>
                  <option value="Afternoon (12:00 PM – 4:00 PM)">Afternoon (12:00 PM – 4:00 PM)</option>
                  <option value="Late Afternoon (4:00 PM – 6:00 PM)">Late Afternoon (4:00 PM – 6:00 PM)</option>
                </select>
              </div>
            </div>

            <div>
              <label for="topic" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">Primary Focus</label>
              <select id="topic" name="topic" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; box-sizing: border-box;">
                <option value="401(k) / IRA / Retirement Planning">401(k) / IRA / Retirement Planning</option>
                <option value="Wealth & Investment Management">Wealth & Investment Management</option>
                <option value="Financial Planning & Estate Strategy">Financial Planning & Estate Strategy</option>
                <option value="Real Estate & Portfolio Diversification">Real Estate & Portfolio Diversification</option>
                <option value="General Inquiry">General Inquiry</option>
              </select>
            </div>

            <div>
              <label for="notes" style="display: block; font-weight: 500; color: var(--text); margin-bottom: 0.4rem;">What would you like to discuss?</label>
              <textarea id="notes" name="notes" rows="4" placeholder="Tell us briefly about your goals or questions..." style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: #ffffff; color: #0f172a; font-family: inherit; resize: vertical; box-sizing: border-box;"></textarea>
            </div>

            <button type="submit" class="btn" style="cursor: pointer; width: 100%;">Request Free Consultation</button>

            <div id="consultation-status" role="status" style="display: none; padding: 0.9rem 1rem; border-radius: 6px; background: rgba(15, 23, 42, 0.06); color: var(--text); font-size: 0.95rem; line-height: 1.5;">
              Your email app should now be open with your consultation request addressed to <strong>info@seeksaveinvestments.com</strong>. If it didn't open automatically, you can email us directly at <a href="mailto:info@seeksaveinvestments.com" style="color: var(--accent);">info@seeksaveinvestments.com</a>.
            </div>
          </form>
        </div>

      </div>
    </section>
  </main>
</div>

